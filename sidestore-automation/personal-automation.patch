+    func testV2ExecutionWireCannotGrantCleanupFromNonterminalReport() throws {
+        var report = AutomationRefreshReport(runID: "ticket")
+        report.cleanupAllowed = true // Inconsistent legacy data must fail closed.
+        var value = try strings(AutomationExecuteV2Report(report: report).json)
+        XCTAssertEqual(value["completionState"], "nonterminal")
