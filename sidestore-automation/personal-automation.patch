+import XCTest
+import Foundation
+import AutomationSQLite
+@testable import SideStoreAutomationPolicy
+
+final class UpgradeStorageTests: XCTestCase {
+    private func directory() throws -> URL {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent("UpgradeStorageSynthetic-" + UUID().uuidString)
+        try FileManager.default.createDirectory(at: url, withIntermediateDirectories: true)
+        return url
+    }
+
+    private func execute(_ db: OpaquePointer, _ sql: String) throws {
+        let status = sqlite3_exec(db, sql, nil, nil, nil)
+        guard status == SQLITE_OK else {
+            throw AutomationUpgradeStorageError.sqlite(stage: "syntheticFixture", code: status)
+        }
+    }
+
+    private func open(_ url: URL) throws -> OpaquePointer {
+        var db: OpaquePointer?
+        let result = sqlite3_open_v2(url.path, &db, SQLITE_OPEN_CREATE | SQLITE_OPEN_READWRITE, nil)
+        guard result == SQLITE_OK, let db else {
+            throw AutomationUpgradeStorageError.sqlite(stage: "syntheticOpen", code: result)
+        }
+        return db
+    }
+
+    private func count(_ url: URL) throws -> Int {
+        let db = try open(url)
+        defer { sqlite3_close(db) }
+        var statement: OpaquePointer?
+        XCTAssertEqual(sqlite3_prepare_v2(db, "SELECT count(*) FROM fixture", -1, &statement, nil), SQLITE_OK)
+        guard let statement else { throw AutomationUpgradeStorageError.invalidSQLite }
+        defer { sqlite3_finalize(statement) }
+        XCTAssertEqual(sqlite3_step(statement), SQLITE_ROW)
+        return Int(sqlite3_column_int(statement, 0))
+    }
+
+    private func fixture(_ url: URL, wal: Bool = true) throws -> OpaquePointer {
+        let db = try open(url)
+        try execute(db, wal ? "PRAGMA journal_mode=WAL" : "PRAGMA journal_mode=DELETE")
+        try execute(db, "PRAGMA wal_autocheckpoint=0")
+        try execute(db, "CREATE TABLE fixture(value TEXT NOT NULL)")
+        try execute(db, "INSERT INTO fixture VALUES('synthetic-committed')")
+        return db
+    }
+
+    func testCommittedWALIsIncludedAndLegacyBytesRemainUnchanged() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_close(writer) }
+        let wal = URL(fileURLWithPath: source.path + "-wal")
+        XCTAssertTrue(FileManager.default.fileExists(atPath: wal.path))
+        let sourceHash = try AutomationUpgradeStorage.fileSHA256(source)
+        let walHash = try AutomationUpgradeStorage.fileSHA256(wal)
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        XCTAssertEqual(try count(target), 1)
+        XCTAssertEqual(try AutomationUpgradeStorage.fileSHA256(source), sourceHash)
+        XCTAssertEqual(try AutomationUpgradeStorage.fileSHA256(wal), walHash)
+        XCTAssertTrue(FileManager.default.fileExists(atPath: root.appendingPathComponent(".upgrade-preservation").path))
+    }
+
+    func testUncommittedWriterChangesAreExcluded() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_exec(writer, "ROLLBACK", nil, nil, nil); sqlite3_close(writer) }
+        try execute(writer, "BEGIN IMMEDIATE")
+        try execute(writer, "INSERT INTO fixture VALUES('synthetic-uncommitted')")
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        XCTAssertEqual(try count(target), 1)
+    }
+
+    func testExistingUnownedTargetIsNeverOverwritten() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let a = try fixture(source), b = try fixture(target, wal: false)
+        sqlite3_close(a); sqlite3_close(b)
+        let before = try AutomationUpgradeStorage.fileSHA256(target)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target))
+        XCTAssertEqual(try AutomationUpgradeStorage.fileSHA256(target), before)
+        XCTAssertTrue(FileManager.default.fileExists(atPath: source.path))
+    }
+
+    func testCommittedReceiptAllowsNewTargetUseWithoutResettingIt() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_close(writer) }
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        let current = try open(target)
+        try execute(current, "INSERT INTO fixture VALUES('synthetic-current-target')")
+        sqlite3_close(current)
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        XCTAssertEqual(try count(target), 2)
+    }
+
+    func testChangedLegacyAfterReceiptFailsWithoutReplacingTarget() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_close(writer) }
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        try execute(writer, "INSERT INTO fixture VALUES('synthetic-later-legacy')")
+        XCTAssertThrowsError(try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target))
+        XCTAssertEqual(try count(target), 1)
+    }
+
+    func testPreparedReceiptCanRecoverOnlyAnExactSnapshotTarget() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_close(writer) }
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        let receipt = root.appendingPathComponent(".new.sqlite.upgrade-receipt.json")
+        var json = try JSONSerialization.jsonObject(with: Data(contentsOf: receipt)) as! [String: Any]
+        json["phase"] = "prepared"
+        try JSONSerialization.data(withJSONObject: json).write(to: receipt, options: .atomic)
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        let reread = try JSONSerialization.jsonObject(with: Data(contentsOf: receipt)) as! [String: Any]
+        XCTAssertEqual(reread["phase"] as? String, "committed")
+    }
+
+    func testPreparedReceiptRejectsAChangedTarget() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_close(writer) }
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        let receipt = root.appendingPathComponent(".new.sqlite.upgrade-receipt.json")
+        var json = try JSONSerialization.jsonObject(with: Data(contentsOf: receipt)) as! [String: Any]
+        json["phase"] = "prepared"
+        try JSONSerialization.data(withJSONObject: json).write(to: receipt, options: .atomic)
+        let targetWriter = try open(target)
+        try execute(targetWriter, "INSERT INTO fixture VALUES('synthetic-uncertain-target')")
+        sqlite3_close(targetWriter)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target))
+        XCTAssertEqual(try count(target), 2)
+    }
+
+    func testSnapshotIntegrityFailureDoesNotReplaceCurrentDatabase() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source)
+        defer { sqlite3_close(writer) }
+        try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target)
+        let receipt = root.appendingPathComponent(".new.sqlite.upgrade-receipt.json")
+        let json = try JSONSerialization.jsonObject(with: Data(contentsOf: receipt)) as! [String: Any]
+        let snapshot = root.appendingPathComponent(".upgrade-preservation").appendingPathComponent(json["snapshotName"] as! String)
+        try Data("synthetic-corrupt-backup".utf8).write(to: snapshot)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target))
+        XCTAssertEqual(try count(target), 1)
+    }
+
+    func testExclusiveSourceLockFailsBoundedlyWithoutPublication() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        let writer = try fixture(source, wal: false)
+        defer { sqlite3_exec(writer, "ROLLBACK", nil, nil, nil); sqlite3_close(writer) }
+        try execute(writer, "BEGIN EXCLUSIVE")
+        let start = ProcessInfo.processInfo.systemUptime
+        XCTAssertThrowsError(try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target))
+        XCTAssertLessThan(ProcessInfo.processInfo.systemUptime - start, 5)
+        XCTAssertFalse(FileManager.default.fileExists(atPath: target.path))
+        XCTAssertTrue(FileManager.default.fileExists(atPath: source.path))
+    }
+
+    func testFileCopyIsVerifiedAndEqualDuplicateIsIdempotent() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.der"), target = root.appendingPathComponent("new.der")
+        let bytes = Data("synthetic-certificate-bytes".utf8)
+        try bytes.write(to: source)
+        try AutomationUpgradeStorage.verifiedCopy(source: source, destination: target)
+        try AutomationUpgradeStorage.verifiedCopy(source: source, destination: target)
+        XCTAssertEqual(try Data(contentsOf: source), bytes)
+        XCTAssertEqual(try Data(contentsOf: target), bytes)
+    }
+
+    func testSameSizeDifferentTargetFailsAndPreservesBoth() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.der"), target = root.appendingPathComponent("new.der")
+        try Data("first".utf8).write(to: source)
+        try Data("other".utf8).write(to: target)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.verifiedCopy(source: source, destination: target))
+        XCTAssertEqual(try String(contentsOf: source), "first")
+        XCTAssertEqual(try String(contentsOf: target), "other")
+    }
+
+    func testDirectoryCopyVerifiesContentAndRejectsSymlinks() throws {
+        let root = try directory(), source = root.appendingPathComponent("Old.app"), target = root.appendingPathComponent("New.app")
+        try FileManager.default.createDirectory(at: source, withIntermediateDirectories: true)
+        try Data("synthetic-app".utf8).write(to: source.appendingPathComponent("Executable"))
+        try AutomationUpgradeStorage.verifiedCopy(source: source, destination: target)
+        XCTAssertEqual(try Data(contentsOf: target.appendingPathComponent("Executable")), Data("synthetic-app".utf8))
+        let linked = root.appendingPathComponent("linked")
+        try FileManager.default.createSymbolicLink(at: linked, withDestinationURL: source)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.verifiedCopy(source: linked, destination: root.appendingPathComponent("Never.app")))
+    }
+
+    func testInvalidSQLiteFailsBeforePublishingTarget() throws {
+        let root = try directory(), source = root.appendingPathComponent("old.sqlite"), target = root.appendingPathComponent("new.sqlite")
+        try Data("synthetic-non-database".utf8).write(to: source)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.preserveSQLite(source: source, destination: target))
+        XCTAssertFalse(FileManager.default.fileExists(atPath: target.path))
+        XCTAssertEqual(try String(contentsOf: source), "synthetic-non-database")
+    }
+
+    func testCounterReadbackAndMalformedValueFailClosed() throws {
+        let root = try directory(), counter = root.appendingPathComponent(".maintenance_counter")
+        XCTAssertEqual(try AutomationUpgradeStorage.readCounter(at: counter, maximum: 5), 0)
+        try AutomationUpgradeStorage.writeCounter(4, at: counter)
+        XCTAssertEqual(try AutomationUpgradeStorage.readCounter(at: counter, maximum: 5), 4)
+        try Data("not-a-counter".utf8).write(to: counter)
+        XCTAssertThrowsError(try AutomationUpgradeStorage.readCounter(at: counter, maximum: 5))
+    }
+}
