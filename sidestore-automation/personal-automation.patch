diff --git a/AutomationTests/AutomationDiagnosticsTests.swift b/AutomationTests/AutomationDiagnosticsTests.swift
new file mode 100644
index 0000000..d6331d9
--- /dev/null
+++ b/AutomationTests/AutomationDiagnosticsTests.swift
@@ -0,0 +1,130 @@
+import Foundation
+import XCTest
+@testable import SideStoreAutomationPolicy
+
+private final class PresentationEnvelope: NSError, @unchecked Sendable {
+    let original: NSError
+    init(_ original: NSError) {
+        self.original = original
+        super.init(domain: original.domain, code: original.code, userInfo: original.userInfo)
+    }
+    required init?(coder: NSCoder) { fatalError("No archival is used in this fixture") }
+}
+
+private enum EvidenceScopeFixture {
+    @TaskLocal static var value: String?
+}
+
+final class AutomationDiagnosticsTests: XCTestCase {
+    private let unwrap: (NSError) -> NSError? = { ($0 as? PresentationEnvelope)?.original }
+
+    func testBusinessCodeSurvivesNSErrorBridgeAndUIEnvelope() {
+        let failure = AutomationFailure("profileIdentityMismatch")
+        let bridged = failure as NSError
+        XCTAssertEqual(bridged.domain, AutomationFailure.errorDomain)
+        XCTAssertEqual(bridged.userInfo[AutomationFailure.codeKey] as? String, failure.code)
+        XCTAssertEqual(AutomationFailure.recoveredCode(from: PresentationEnvelope(bridged), unwrap: unwrap), failure.code)
+    }
+
+    func testNestedFoundationUnderlyingErrorPreservesBusinessCode() {
+        let inner = AutomationFailure("profilePlanMismatch") as NSError
+        let outer = NSError(domain: NSCocoaErrorDomain, code: 1, userInfo: [NSUnderlyingErrorKey: inner])
+        XCTAssertEqual(AutomationFailure.recoveredCode(from: outer), "profilePlanMismatch")
+    }
+
+    func testCancellationIdentitySurvivesPresentationEnvelope() {
+        let error = PresentationEnvelope(CancellationError() as NSError)
+        XCTAssertTrue(AutomationFailure.isCancellation(error, unwrap: unwrap))
+        XCTAssertFalse(AutomationFailure.isCancellation(NSError(domain: NSURLErrorDomain, code: -1009)))
+    }
+
+    func testErrorChainIsBoundedAndCycleSafe() {
+        let error = NSError(domain: NSCocoaErrorDomain, code: 1)
+        XCTAssertEqual(AutomationDiagnosticPrivacy.errorChain(error, unwrap: { $0 }).count, 1)
+        let chain = (0..<8).reduce(error) { current, _ in
+            NSError(domain: NSCocoaErrorDomain, code: 2, userInfo: [NSUnderlyingErrorKey: current])
+        }
+        XCTAssertEqual(AutomationDiagnosticPrivacy.errorChain(chain).count, 4)
+    }
+
+    func testDiagnosticsNeverSerializeDescriptionsUserInfoOrUnrecognizedDomains() {
+        let secrets = ["private@example.invalid", "password-value", "https://private.invalid/token", "com.personal.application", "12345678-1234-1234-1234-123456789ABC"]
+        let error = NSError(domain: secrets[0], code: -1, userInfo: [NSLocalizedDescriptionKey: secrets.joined(separator: " "), "Authorization": secrets[1]])
+        let trace = AutomationDiagnosticTrace()
+        _ = trace.enter(.sessionPreparation)
+        let line = trace.failure(error)
+        XCTAssertTrue(line.contains("phase=sessionPreparation"))
+        XCTAssertTrue(line.contains("code=sessionPreparationFailed"))
+        XCTAssertTrue(line.contains("errors=other:-1"))
+        for secret in secrets { XCTAssertFalse(line.contains(secret)) }
+    }
+
+    func testOnlySourceDefinedBusinessCodesCanReachDiagnostics() {
+        let unknown = AutomationFailure("12345678-1234-1234-1234-123456789ABC")
+        XCTAssertEqual(AutomationFailure.recoveredCode(from: unknown), "unclassifiedAutomationFailure")
+        let error = NSError(domain: AutomationFailure.errorDomain, code: 1,
+                            userInfo: [AutomationFailure.codeKey: "private@example.invalid"])
+        XCTAssertNil(AutomationFailure.recoveredCode(from: error))
+        XCTAssertFalse(AutomationDiagnosticTrace().failure(error).contains("private@example.invalid"))
+    }
+
+    func testSafeKnownDomainAndNumericCodeRemainReadable() {
+        let line = AutomationDiagnosticTrace().failure(NSError(domain: NSURLErrorDomain, code: -1009))
+        XCTAssertTrue(line.contains("NSURLErrorDomain:-1009"))
+        XCTAssertTrue(line.contains("code=intentRuntimeFailed"))
+    }
+
+    func testCancellationReasonAndPhaseRemainSeparateFromBusinessOutcome() {
+        let trace = AutomationDiagnosticTrace()
+        _ = trace.enter(.rustdeskPipeline)
+        let user = trace.cancellation(.userCancelled)
+        let timeout = trace.cancellation(.timeout)
+        XCTAssertTrue(user.contains("phase=rustdeskPipeline reason=userCancelled"))
+        XCTAssertTrue(timeout.contains("phase=rustdeskPipeline reason=timeout"))
+        XCTAssertEqual(trace.currentStage, .rustdeskPipeline)
+    }
+
+    func testOldPersistedLeaseDecodesWithoutAnyNewDiagnosticFields() throws {
+        let old = #"{"runID":"77B875E7-047C-4127-9E88-A7BA25BF8230","phase":"prepared","report":{"schemaVersion":1,"runID":"77B875E7-047C-4127-9E88-A7BA25BF8230","terminal":false,"cleanupAllowed":false,"outcome":"unverified","rustdesk":{"completed":false,"bundleID":"com.bearberni.rustdesk.v2","installedProfileUUIDs":[]},"sidestore":{"completed":false,"bundleID":"","installedProfileUUIDs":[]},"errors":[]}}"#
+        // Decode an actual old-model serialization rather than manufacturing
+        // defaults for a new model. Diagnostics did not add Codable properties.
+        let fixture = AutomationLease(runID: "77B875E7-047C-4127-9E88-A7BA25BF8230", phase: .prepared,
+                                     report: .init(runID: "77B875E7-047C-4127-9E88-A7BA25BF8230"))
+        let serialized = try JSONEncoder().encode(fixture)
+        XCTAssertEqual(try JSONDecoder().decode(AutomationLease.self, from: Data(old.utf8)), fixture)
+        XCTAssertEqual(try JSONDecoder().decode(AutomationLease.self, from: serialized), fixture)
+        XCTAssertFalse(String(decoding: serialized, as: UTF8.self).contains("diagnostic"))
+    }
+
+    func testWireV2RemainsStringOnlyAndCompatibleWithExistingShortcut() throws {
+        var report = AutomationRefreshReport(runID: "77B875E7-047C-4127-9E88-A7BA25BF8230")
+        report.terminal = true
+        report.cleanupAllowed = true
+        report.outcome = .failed
+        report.errors = [.init(code: "sessionPreparationFailed", app: "rustdesk")]
+        let json = AutomationExecuteV2Report(report: report).json
+        let values = try JSONDecoder().decode([String: String].self, from: Data(json.utf8))
+        XCTAssertEqual(values["protocol"], "sidestore-personal-renewal/2")
+        XCTAssertEqual(values["completionState"], "terminal")
+        XCTAssertEqual(values["cleanupState"], "allowed")
+        XCTAssertEqual(values["errorCode"], "sessionPreparationFailed")
+    }
+
+    func testStructuredChildrenInheritTaskLocalAndDetachedNeedsExplicitBinding() async {
+        let structured: String? = await EvidenceScopeFixture.$value.withValue("scope-present") {
+            await withTaskGroup(of: String?.self) { group in
+                group.addTask { EvidenceScopeFixture.value }
+                return await group.next() ?? nil
+            }
+        }
+        let detached: String? = await EvidenceScopeFixture.$value.withValue("scope-present") {
+            await Task.detached { EvidenceScopeFixture.value }.value
+        }
+        let rebound: String? = await Task.detached {
+            EvidenceScopeFixture.$value.withValue("scope-present") { EvidenceScopeFixture.value }
+        }.value
+        XCTAssertEqual(structured, "scope-present")
+        XCTAssertNil(detached)
+        XCTAssertEqual(rebound, "scope-present")
+    }
+}
diff --git a/AutomationTests/AutomationPortConfigurationTests.swift b/AutomationTests/AutomationPortConfigurationTests.swift
new file mode 100644
index 0000000..9c9aa22
--- /dev/null
+++ b/AutomationTests/AutomationPortConfigurationTests.swift
@@ -0,0 +1,134 @@
+import Foundation
+import XCTest
+@testable import SideStoreAutomationPolicy
+
+final class AutomationPortConfigurationTests: XCTestCase {
+    private typealias Keys = AutomationPortConfiguration.Keys
+
+    private func isolated(_ body: (UserDefaults) throws -> Void) rethrows {
+        let suite = "SideStoreAutomationPortTests." + UUID().uuidString
+        let defaults = UserDefaults(suiteName: suite)!
+        defaults.removePersistentDomain(forName: suite)
+        defer { defaults.removePersistentDomain(forName: suite) }
+        try body(defaults)
+    }
+
+    func testTemporaryManualPortBecomesHintAndHasLocalRollbackCopy() {
+        isolated { defaults in
+            defaults.set(64636, forKey: Keys.manualPort)
+            defaults.set(false, forKey: Keys.automaticRetry)
+            XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .migratedWithManualHint)
+            XCTAssertNil(defaults.object(forKey: Keys.manualPort))
+            XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), 64636)
+            XCTAssertEqual(defaults.integer(forKey: Keys.rollbackManualPort), 64636)
+            XCTAssertTrue(defaults.bool(forKey: Keys.automaticRetry))
+            XCTAssertEqual(defaults.integer(forKey: Keys.version), 1)
+        }
+    }
+
+    func testMigrationUsesProvidedPortRatherThanHardcodedObservedPort() {
+        for port in [1, 12345, 49153, 65535] {
+            isolated { defaults in
+                defaults.set(port, forKey: Keys.manualPort)
+                XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .migratedWithManualHint)
+                XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), port)
+                XCTAssertEqual(defaults.integer(forKey: Keys.rollbackManualPort), port)
+            }
+        }
+    }
+
+    func testValidManualSelectionSupersedesOlderDiscoveredCache() {
+        isolated { defaults in
+            defaults.set(12345, forKey: Keys.discoveredPort)
+            defaults.set(64636, forKey: Keys.manualPort)
+            _ = AutomationPortConfiguration.migrateOnce(to: defaults)
+            XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), 64636)
+        }
+    }
+
+    func testExistingValidDiscoveryCacheIsRetainedWithoutManualPort() {
+        isolated { defaults in
+            defaults.set(54321, forKey: Keys.discoveredPort)
+            XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .migratedWithExistingHint)
+            XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), 54321)
+            XCTAssertNil(defaults.object(forKey: Keys.rollbackManualPort))
+        }
+    }
+
+    func testRepeatedCallDoesNotOverwriteLaterManualChoiceOrRetryPreference() {
+        isolated { defaults in
+            defaults.set(64636, forKey: Keys.manualPort)
+            _ = AutomationPortConfiguration.migrateOnce(to: defaults)
+            defaults.set(23456, forKey: Keys.manualPort)
+            defaults.set(34567, forKey: Keys.discoveredPort)
+            defaults.set(false, forKey: Keys.automaticRetry)
+            XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .alreadyApplied)
+            XCTAssertEqual(defaults.integer(forKey: Keys.manualPort), 23456)
+            XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), 34567)
+            XCTAssertEqual(defaults.integer(forKey: Keys.rollbackManualPort), 64636)
+            XCTAssertFalse(defaults.bool(forKey: Keys.automaticRetry))
+        }
+    }
+
+    func testFutureMigrationMarkerIsNotDowngraded() {
+        isolated { defaults in
+            defaults.set(2, forKey: Keys.version)
+            defaults.set(23456, forKey: Keys.manualPort)
+            XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .alreadyApplied)
+            XCTAssertEqual(defaults.integer(forKey: Keys.manualPort), 23456)
+            XCTAssertEqual(defaults.integer(forKey: Keys.version), 2)
+        }
+    }
+
+    func testMalformedManualPortsNeverBecomeHintsOrRollbackValues() {
+        let invalid: [Any] = [0, -1, 65536, Int.max, true, false, 12345.0, 12345.5, "64636", "invalid", Data([1, 2])]
+        for value in invalid {
+            isolated { defaults in
+                defaults.set(value, forKey: Keys.manualPort)
+                XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .migratedWithoutHint)
+                XCTAssertNil(defaults.object(forKey: Keys.manualPort))
+                XCTAssertNil(defaults.object(forKey: Keys.discoveredPort))
+                XCTAssertNil(defaults.object(forKey: Keys.rollbackManualPort))
+                XCTAssertTrue(defaults.bool(forKey: Keys.automaticRetry))
+            }
+        }
+    }
+
+    func testInvalidManualValueDoesNotDestroyValidExistingCache() {
+        isolated { defaults in
+            defaults.set(70000, forKey: Keys.manualPort)
+            defaults.set(54321, forKey: Keys.discoveredPort)
+            XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .migratedWithExistingHint)
+            XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), 54321)
+        }
+    }
+
+    func testInvalidDiscoveredCacheIsNotUsedAsHint() {
+        let invalid: [Any] = ["64636", 12345.5, true, 65536]
+        for value in invalid {
+            isolated { defaults in
+                defaults.set(value, forKey: Keys.discoveredPort)
+                XCTAssertEqual(AutomationPortConfiguration.migrateOnce(to: defaults), .migratedWithoutHint)
+                XCTAssertNil(defaults.object(forKey: Keys.discoveredPort))
+            }
+        }
+    }
+
+    func testPreviouslySavedRollbackSurvivesAnInterruptedMigration() {
+        isolated { defaults in
+            defaults.set(12345, forKey: Keys.rollbackManualPort)
+            defaults.set(23456, forKey: Keys.manualPort)
+            _ = AutomationPortConfiguration.migrateOnce(to: defaults)
+            XCTAssertEqual(defaults.integer(forKey: Keys.rollbackManualPort), 12345)
+            XCTAssertEqual(defaults.integer(forKey: Keys.discoveredPort), 23456)
+        }
+    }
+
+    func testUnrelatedPreferencesAreUntouched() {
+        isolated { defaults in
+            defaults.set("preserve", forKey: "unrelatedPreference")
+            _ = AutomationPortConfiguration.migrateOnce(to: defaults)
+            XCTAssertEqual(defaults.string(forKey: "unrelatedPreference"), "preserve")
+        }
+    }
+}
diff --git a/AutomationTests/AutomationRefreshPolicyTests.swift b/AutomationTests/AutomationRefreshPolicyTests.swift
new file mode 100644
index 0000000..6921a1e
--- /dev/null
+++ b/AutomationTests/AutomationRefreshPolicyTests.swift
@@ -0,0 +1,339 @@
+import XCTest
+@testable import SideStoreAutomationPolicy
+
+final class AutomationRefreshPolicyTests: XCTestCase {
+    private func preparedLease() -> AutomationLease {
+        let id = "77B875E7-047C-4127-9E88-A7BA25BF8230"
+        return .init(runID: id, phase: .prepared, report: .init(runID: id))
+    }
+
+    private func strings(_ json: String) throws -> [String: String] {
+        // This decoder rejects JSON booleans, numbers, arrays and nested objects.
+        try JSONDecoder().decode([String: String].self, from: Data(json.utf8))
+    }
+
+    func testPinnedIdeviceDumpContractAcceptsOnlyOurNormalizedPrivateDirectory() {
+        let directory = URL(fileURLWithPath: "/private/automation-run/PROVISION", isDirectory: true)
+        XCTAssertEqual(AutomationRefreshPolicy.profileDumpLayout(returned: directory.path, expectedDirectory: directory), .uuidDirectory)
+        XCTAssertEqual(AutomationRefreshPolicy.profileDumpLayout(returned: directory.path + "/", expectedDirectory: directory), .uuidDirectory)
+        XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: "/private/another-run/PROVISION", expectedDirectory: directory))
+        XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: "/private/automation-run/PROVISION/../../outside", expectedDirectory: directory))
+        XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: "dump succeeded", expectedDirectory: directory))
+    }
+
+    func testPinnedLibimobiledeviceRemotePairingDumpIsCountNotDirectory() {
+        let directory = URL(fileURLWithPath: "/private/automation-run/PROVISION", isDirectory: true)
+        let layout = AutomationRefreshPolicy.profileDumpLayout(returned: "Successfully dumped 2 profiles", expectedDirectory: directory)
+        XCTAssertEqual(layout, .indexedFiles(count: 2))
+        XCTAssertTrue(AutomationRefreshPolicy.profileDumpFileMatches("Profile_0.mobileprovision", layout: .indexedFiles(count: 2)))
+        XCTAssertTrue(AutomationRefreshPolicy.profileDumpFileMatches("Profile_1.mobileprovision", layout: .indexedFiles(count: 2)))
+        for name in ["Profile_2.mobileprovision", "Profile_-1.mobileprovision", "Profile_00.mobileprovision", "../Profile_0.mobileprovision", "Profile_0.plist"] {
+            XCTAssertFalse(AutomationRefreshPolicy.profileDumpFileMatches(name, layout: .indexedFiles(count: 2)))
+        }
+        for text in ["Successfully dumped -1 profiles", "Successfully dumped +2 profiles", "Successfully dumped 513 profiles", "Successfully dumped 2 profiles extra"] {
+            XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: text, expectedDirectory: directory))
+        }
+    }
+
+    func testPinnedLibimobiledeviceLockdownDumpPreservesInlineProfileBytes() throws {
+        let directory = URL(fileURLWithPath: "/private/automation-run/PROVISION", isDirectory: true)
+        // Format fixtures, not fabricated CMS installation evidence. The real
+        // verifier must separately parse, UUID-match and hash every target.
+        let profiles = [Data([0x30, 0x82, 0x01, 0x00]), Data([0x30, 0x01, 0xFF])]
+        let xml = try PropertyListSerialization.data(fromPropertyList: profiles, format: .xml, options: 0)
+        XCTAssertEqual(AutomationRefreshPolicy.profileDumpLayout(returned: String(decoding: xml, as: UTF8.self), expectedDirectory: directory), .inlineProfiles(profiles))
+        let invalidPayloads: [Any] = [["not profile data"], ["ProfileArray": profiles]]
+        for invalid in invalidPayloads {
+            let bytes = try PropertyListSerialization.data(fromPropertyList: invalid, format: .xml, options: 0)
+            XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: String(decoding: bytes, as: UTF8.self), expectedDirectory: directory))
+        }
+        let emptyProfile = try PropertyListSerialization.data(fromPropertyList: [Data()], format: .xml, options: 0)
+        XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: String(decoding: emptyProfile, as: UTF8.self), expectedDirectory: directory))
+    }
+
+    func testDumpFilenameSpellingDoesNotDetermineProfileIdentity() {
+        let lowerUUID = "77b875e7-047c-4127-9e88-a7ba25bf8230"
+        XCTAssertEqual(UUID(uuidString: lowerUUID)?.uuidString, "77B875E7-047C-4127-9E88-A7BA25BF8230")
+        XCTAssertTrue(AutomationRefreshPolicy.profileDumpFileMatches(lowerUUID + ".mobileprovision", layout: .uuidDirectory))
+        XCTAssertTrue(AutomationRefreshPolicy.profileDumpFileMatches("unknown_0.mobileprovision", layout: .uuidDirectory))
+        XCTAssertFalse(AutomationRefreshPolicy.profileDumpFileMatches(lowerUUID + ".plist", layout: .uuidDirectory))
+        XCTAssertFalse(AutomationRefreshPolicy.profileDumpFileMatches("/outside/" + lowerUUID + ".mobileprovision", layout: .uuidDirectory))
