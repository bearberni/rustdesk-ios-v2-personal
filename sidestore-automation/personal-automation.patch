+        for name in ["Profile_2.mobileprovision", "Profile_-1.mobileprovision", "Profile_00.mobileprovision", "../Profile_0.mobileprovision", "Profile_0.plist"] {
+            XCTAssertFalse(AutomationRefreshPolicy.profileDumpFileMatches(name, layout: .indexedFiles(count: 2)))
+        }
+        for text in ["Successfully dumped -1 profiles", "Successfully dumped +2 profiles", "Successfully dumped 513 profiles", "Successfully dumped 2 profiles extra"] {
+            XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: text, expectedDirectory: directory))
+        }
+    }
+
+    func testPinnedLibimobiledeviceLockdownDumpPreservesInlineProfileBytes() throws {
+        let directory = URL(fileURLWithPath: "/private/automation-run/PROVISION", isDirectory: true)
+        // Format fixtures, not fabricated CMS installation evidence. The real
+        // verifier must separately parse, UUID-match and hash every target.
+        let profiles = [Data([0x30, 0x82, 0x01, 0x00]), Data([0x30, 0x01, 0xFF])]
+        let xml = try PropertyListSerialization.data(fromPropertyList: profiles, format: .xml, options: 0)
+        XCTAssertEqual(AutomationRefreshPolicy.profileDumpLayout(returned: String(decoding: xml, as: UTF8.self), expectedDirectory: directory), .inlineProfiles(profiles))
+        let invalidPayloads: [Any] = [["not profile data"], ["ProfileArray": profiles]]
+        for invalid in invalidPayloads {
+            let bytes = try PropertyListSerialization.data(fromPropertyList: invalid, format: .xml, options: 0)
+            XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: String(decoding: bytes, as: UTF8.self), expectedDirectory: directory))
+        }
+        let emptyProfile = try PropertyListSerialization.data(fromPropertyList: [Data()], format: .xml, options: 0)
+        XCTAssertNil(AutomationRefreshPolicy.profileDumpLayout(returned: String(decoding: emptyProfile, as: UTF8.self), expectedDirectory: directory))
