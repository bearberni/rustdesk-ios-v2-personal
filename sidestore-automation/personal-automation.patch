+    /// Automation-only overload: install completion before starting the task,
+    /// propagate its optional evidence scope, and expose activeTask for joining.
+    /// The existing refresh entry point and its behavior are unchanged.
+    func refreshForAutomation(_ app: InstalledApp, dbContext: NSManagedObjectContext,
+                              evidence: AutomationProfileEvidence,
+                              completion: AutomationPipelineCompletion) -> RefreshGroup {
+        let context = self.makeAuthenticatedContext(dbBackgroundContext: dbContext)
+        let group = RefreshGroup(context: context)
+        group.completionHandler = { completion.complete($0) }
+        let handler = self.makePipelineHandler(presentingViewController: nil)
+        let bundleID = app.bundleIdentifier
+        group.activeTask = Task.detached {
+            await AutomationProfileEvidence.$current.withValue(evidence) {
+                do {
+                    try await self.pipelineRunner.perform([.refresh(app)], handler: handler, group: group)
+                } catch {
+                    group.context.error = error
+                    group.completionHandler?([bundleID: .failure(error)])
+                }
+            }
+        }
+        return group
+    }
     
