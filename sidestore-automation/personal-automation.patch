+import Foundation
+import CryptoKit
+@preconcurrency import CoreData
+import SideSign
+import Minimuxer
+
+final class AutomationCancellation: @unchecked Sendable {
+    private let lock = NSLock()
+    private var cancelled = false
+    private var group: RefreshGroup?
+    var isCancelled: Bool { lock.withLock { cancelled } }
+    func cancel() {
+        let current = lock.withLock { cancelled = true; return group }
+        current?.cancel()
+    }
+    func attach(_ newGroup: RefreshGroup?) {
+        let shouldCancel = lock.withLock { group = newGroup; return cancelled }
+        if shouldCancel { newGroup?.cancel() }
+    }
+    func check() throws {
+        if isCancelled || Task.isCancelled { throw CancellationError() }
+    }
+}
+
+/// No checked continuation is needed: completion is installed before startup,
+/// and callers join activeTask before reading this exactly-once result box.
+final class AutomationPipelineCompletion: @unchecked Sendable {
+    private let lock = NSLock()
+    private var results: [String: Result<InstalledApp, Error>]?
+    private var count = 0
+    func complete(_ value: [String: Result<InstalledApp, Error>]) {
+        lock.withLock {
+            count += 1
+            if results == nil { results = value }
+        }
+    }
+    func value() throws -> [String: Result<InstalledApp, Error>] {
+        try lock.withLock {
+            guard count == 1, let results else { throw AutomationFailure("invalidCompletionCount") }
+            return results
+        }
+    }
+}
+
+actor AutomationRefreshCoordinator {
+    static let shared = AutomationRefreshCoordinator()
+    private var lease: AutomationLease?
+    private var worker: Task<AutomationRefreshReport, Never>?
+    private var cancellation: AutomationCancellation?
+    private var storageFailed = false
+    private var coldPreparedEvidence: AutomationColdPreparedEvidence?
+    private let journalURL: URL
+
+    init() {
+        let base = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first
+            ?? FileManager.default.temporaryDirectory
+        journalURL = base.appendingPathComponent("SideStoreAutomation", isDirectory: true).appendingPathComponent("lease-v1.json")
+        if FileManager.default.fileExists(atPath: journalURL.path) {
+            do {
+                let bytes = try Data(contentsOf: journalURL)
+                guard bytes.count < 256_000 else { throw AutomationFailure("invalidJournal") }
+                var previous = try JSONDecoder().decode(AutomationLease.self, from: bytes)
+                coldPreparedEvidence = AutomationColdPreparedEvidence(diskLease: previous, diskSHA256: Self.journalHash(bytes))
+                previous.markProcessInterrupted()
+                lease = previous
+            } catch { storageFailed = true }
+        }
+    }
+
+    private func persist() throws {
+        guard let lease else { throw AutomationFailure("missingJournalLease") }
+        try persist(lease)
+    }
+
+    private func persist(_ value: AutomationLease) throws {
+        try FileManager.default.createDirectory(at: journalURL.deletingLastPathComponent(), withIntermediateDirectories: true)
+        let data = try JSONEncoder().encode(value)
+        try data.write(to: journalURL, options: .atomic)
+    }
+
+    private static func journalHash(_ bytes: Data) -> String {
+        SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
+    }
+
+    /// Only V2 may acquire a ticket. A same-process fresh prepared lease is
+    /// busy. Cold recovery requires the original prepared disk evidence and
+    /// never follows merely from interrupted/worker==nil.
+    func prepareV2() -> AutomationPrepareV2Report {
+        guard !storageFailed else {
+            return storageErrorV2("journalUnavailable")
+        }
+        if let current = lease, current.phase != .finalized {
+            if let evidence = coldPreparedEvidence, current.phase == .interrupted,
+               current.runID == evidence.runID, worker == nil, cancellation == nil {
+                let id = UUID().uuidString
+                let prepared = AutomationLease(runID: id, phase: .prepared, report: .init(runID: id))
+                do {
+                    try recoverColdPrepared(evidence: evidence, current: current, replacement: prepared)
+                    lease = prepared
+                    coldPreparedEvidence = nil
+                    return .init(report: .init(ready: true, runID: prepared.runID, outcome: "ready"),
+                                 phase: "prepared", recoveryState: "abandonedBeforeExecution")
+                } catch {
+                    storageFailed = true
+                    return storageErrorV2((error as? AutomationFailure)?.code ?? "preparedRecoveryStorageFailed")
+                }
+            }
+            return .init(report: .init(ready: false, runID: current.runID,
+                                      outcome: current.phase == .interrupted ? "interrupted" : "busy"),
+                         phase: current.phase.rawValue, recoveryState: "blocked")
+        }
+        let id = UUID().uuidString
+        let prepared = AutomationLease(runID: id, phase: .prepared, report: .init(runID: id))
+        do { try persist(prepared) }
+        catch {
+            storageFailed = true
+            return storageErrorV2("journalUnavailable")
+        }
+        lease = prepared
+        coldPreparedEvidence = nil
+        return .init(report: .init(ready: true, runID: id, outcome: "ready"), phase: "prepared")
+    }
+
+    private func storageErrorV2(_ code: String) -> AutomationPrepareV2Report {
+        .init(report: .init(ready: false, runID: lease?.runID ?? "", outcome: "unverified",
+                            errors: [.init(code: code, app: nil)]),
+              phase: lease?.phase.rawValue ?? "unknown", recoveryState: "blocked")
+    }
+
+    /// Synchronous actor-owned transaction: no await can interleave another
+    /// Prepare/Execute between validation, backup and durable replacement.
+    /// A backup/receipt/read/write failure preserves the old in-memory ticket
+    /// and blocks further work. No worker is created anywhere in this method.
+    private func recoverColdPrepared(evidence: AutomationColdPreparedEvidence, current: AutomationLease,
+                                     replacement: AutomationLease) throws {
+        let bytes = try Data(contentsOf: journalURL)
+        guard bytes.count < 256_000 else { throw AutomationFailure("invalidJournal") }
+        let disk = try JSONDecoder().decode(AutomationLease.self, from: bytes)
+        guard evidence.permitsRecovery(current: current, disk: disk, diskSHA256: Self.journalHash(bytes),
+                                       hasWorker: worker != nil, hasCancellation: cancellation != nil) else {
+            throw AutomationFailure("preparedRecoveryEvidenceChanged")
+        }
+        let directory = journalURL.deletingLastPathComponent().appendingPathComponent("PreparedRecovery", isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let name = UUID().uuidString
+        let backupURL = directory.appendingPathComponent(name + ".original.json")
+        try bytes.write(to: backupURL, options: .withoutOverwriting)
+        guard try Data(contentsOf: backupURL) == bytes else { throw AutomationFailure("preparedRecoveryBackupFailed") }
+        let receipt = PreparedRecoveryReceipt(event: "abandonedBeforeExecution", originalRunID: disk.runID,
+            replacementRunID: replacement.runID, originalSHA256: evidence.diskSHA256,
+            backupFileName: backupURL.lastPathComponent, recordedAt: AutomationRefreshPolicy.timestamp(Date()))
+        try JSONEncoder().encode(receipt).write(to: directory.appendingPathComponent(name + ".receipt.json"), options: .withoutOverwriting)
+        // Check again after recording the backup, before overwriting anything.
+        guard try Data(contentsOf: journalURL) == bytes else { throw AutomationFailure("preparedRecoveryEvidenceChanged") }
+        try persist(replacement)
+    }
+
+    /// For a legitimate Prepare ticket this method never returns while its
+    /// backend is active. Cancellation requests cancel AND JOIN that backend.
+    /// A normal shortcut can save this raw result, restore VPNs, then Finalize.
+    func execute(runID: String, progress: Progress, cancellation requestedCancellation: AutomationCancellation) async -> AutomationRefreshReport {
+        guard let current = lease, current.runID == runID else { return invalidTicket(runID) }
+        if current.phase == .awaitingCleanup { return current.report }
+        if current.phase == .running, let existing = worker { return await existing.value }
+        guard current.canExecute(runID), !storageFailed else { return invalidTicket(runID) }
+
+        do {
+            guard let running = try AutomationRefreshPolicy.commitRunningLease(current, runID: runID, persist: { try persist($0) }) else {
+                return invalidTicket(runID)
+            }
+            lease = running
+        } catch {
+            storageFailed = true
+            return finishWithoutWorker(runID, outcome: .unverified, code: "journalUnavailable")
+        }
+        // A durable running lease is a prerequisite, never a post-start log.
+        coldPreparedEvidence = nil
+        cancellation = requestedCancellation
+        let task = Task.detached {
+            await AutomationRefreshWorker.run(runID: runID, progress: progress, cancellation: requestedCancellation)
+        }
+        worker = task
+        let report = await withTaskCancellationHandler {
+            await task.value
+        } onCancel: {
+            requestedCancellation.cancel()
+        }
+        return storeTerminal(report)
+    }
+
+    func cancelAndDrain(runID: String, cancellation requestedCancellation: AutomationCancellation) async -> AutomationRefreshReport {
+        guard let current = lease, current.runID == runID else { return invalidTicket(runID) }
+        requestedCancellation.cancel()
+        cancellation?.cancel()
+        if let task = worker { return storeTerminal(await task.value) }
+        if current.phase == .awaitingCleanup { return current.report }
+        if current.phase == .prepared {
+            return finishWithoutWorker(runID, outcome: .cancelled, code: "executionNotStarted")
+        }
+        return invalidTicket(runID)
+    }
+
+    private func finishWithoutWorker(_ runID: String, outcome: AutomationRefreshReport.Outcome, code: String) -> AutomationRefreshReport {
+        var report = AutomationRefreshReport(runID: runID)
+        report.terminal = true
+        report.cleanupAllowed = true
+        report.outcome = outcome
+        report.errors = [.init(code: code, app: nil)]
+        return storeTerminal(report)
+    }
+
+    private func storeTerminal(_ value: AutomationRefreshReport) -> AutomationRefreshReport {
+        guard var current = lease, current.runID == value.runID else { return invalidTicket(value.runID) }
+        if current.phase == .awaitingCleanup || current.phase == .finalized {
+            return current.report
+        }
+        guard current.acceptTerminal(value) else { return invalidTicket(value.runID) }
+        var report = value
+        // Worker returned only after joining every native operation it started.
+        lease = current
+        worker = nil
+        cancellation = nil
+        do { try persist() }
+        catch {
+            storageFailed = true
+            report.outcome = .unverified
+            report.errors.append(.init(code: "journalUnavailable", app: nil))
+            lease?.report = report
+        }
+        return report
+    }
+
+    func finalizeV2(runID: String) -> AutomationFinalizeV2Report {
+        .init(report: finalizeReport(runID: runID))
+    }
+
+    private func finalizeReport(runID: String) -> AutomationFinalizeReport {
+        guard let current = lease, current.canFinalize(runID), worker == nil else {
+            return AutomationFinalizeReport(runID: runID, finalized: false, released: false, outcome: "invalidTicket")
+        }
+        lease?.phase = .finalized
+        do { try persist() }
+        catch {
+            lease?.phase = .awaitingCleanup
+            storageFailed = true
+            return AutomationFinalizeReport(runID: runID, finalized: false, released: false, outcome: "journalUnavailable")
+        }
+        return AutomationFinalizeReport(runID: runID, finalized: true, released: true, outcome: "finalized")
+    }
+
+    func status() -> AutomationRefreshReport {
+        lease?.report ?? invalidTicket("")
+    }
+
+    private func invalidTicket(_ id: String) -> AutomationRefreshReport {
+        var report = AutomationRefreshReport(runID: id)
+        report.errors = [.init(code: "invalidOrInterruptedTicket", app: nil)]
+        // Never grant a stale/invalid caller permission to change another run's VPN.
+        return report
+    }
+}
+
+private struct PreparedRecoveryReceipt: Codable {
+    let event: String
+    let originalRunID: String
+    let replacementRunID: String
+    let originalSHA256: String
+    let backupFileName: String
+    let recordedAt: String
+}
+
+private struct AutomationTarget: @unchecked Sendable {
+    let app: InstalledApp
+    let originalID: String
+    let installedID: String
+    let certificateSerial: String
+    let profileIDs: Set<String>
+}
+
+private enum AutomationRefreshWorker {
+    static func run(runID: String, progress: Progress, cancellation: AutomationCancellation) async -> AutomationRefreshReport {
+        var report = AutomationRefreshReport(runID: runID)
+        progress.totalUnitCount = 220
+        progress.localizedDescription = "Renewing RustDesk V2 and SideStore"
+        do {
+            try cancellation.check()
+            try await DatabaseManager.shared.start()
+            guard !CellularRefreshManager.shared.isEnabled else { throw AutomationFailure("cellularRefreshMustBeDisabled") }
+            guard !AppManager.shared.isActivelyManagingAnyApp else { throw AutomationFailure("anotherOperationActive") }
+            try await waitForNetworkReady(progress: progress, cancellation: cancellation)
+            _ = try await AuthManager.shared.getAuthenticatedTeam()
+            _ = try await AuthManager.shared.getAuthenticatedSession()
+            try cancellation.check()
+            let context = DatabaseManager.shared.persistentContainer.newBackgroundContext()
+            let targets = try await context.perform { try findTargets(context: context) }
+            report.rustdesk.bundleID = targets[0].installedID
+            report.sidestore.bundleID = targets[1].installedID
+            progress.completedUnitCount = 10
+
+            for (index, target) in targets.enumerated() {
+                try cancellation.check()
+                guard !AppManager.shared.isActivelyManagingAnyApp else { throw AutomationFailure("anotherOperationActive") }
+                progress.localizedAdditionalDescription = index == 0 ? "Refreshing RustDesk V2" : "Refreshing SideStore"
+                let evidence = AutomationProfileEvidence(mainBundleID: target.installedID,
+                    certificateSerial: target.certificateSerial, expectedProfileIDs: target.profileIDs)
+                let completion = AutomationPipelineCompletion()
+                let group = await context.perform {
+                    AppManager.shared.refreshForAutomation(target.app, dbContext: context, evidence: evidence, completion: completion)
+                }
+                cancellation.attach(group)
+                progress.addChild(group.progress, withPendingUnitCount: 100)
+                guard let active = group.activeTask else { throw AutomationFailure("missingBackendTask") }
+                // Do not race a timeout, UI notification or cancellation against
+                // completion. Native FFI may not cancel immediately: JOIN it.
+                await active.value
+                cancellation.attach(nil)
+                try cancellation.check()
+                let result = try completion.value()
+                let ids = result.keys.sorted()
+                let successes = try await context.perform { () throws -> [String] in
+                    try result.map { id, value in
+                        let app = try value.get()
+                        guard app.bundleIdentifier == target.originalID,
+                              app.resignedBundleIdentifier == target.installedID else {
+                            throw AutomationFailure("completionIdentityMismatch")
+                        }
+                        return id
+                    }.sorted()
+                }
+                guard AutomationRefreshPolicy.exactCompletion(requested: target.originalID,
+                    resultIDs: ids, succeededIDs: successes) else { throw AutomationFailure("emptyOrMismatchedResult") }
+                progress.localizedAdditionalDescription = "Verifying installed profiles"
+                let proof: (profiles: [AutomationProfileEvidence.Profile], main: AutomationProfileEvidence.Profile)
+                do { proof = try await evidence.verifyInstalledOnDevice() }
+                catch let failure as AutomationFailure { throw failure }
+                catch { throw AutomationFailure("profileReadbackUnexpectedFailure") }
+                try cancellation.check()
+                let appReport = AutomationAppReport(completed: true, bundleID: target.installedID,
+                    expiresAt: AutomationRefreshPolicy.timestamp(proof.main.expires),
+                    installedProfileUUIDs: proof.profiles.map(\.uuid).sorted())
+                if index == 0 { report.rustdesk = appReport } else { report.sidestore = appReport }
+            }
+            guard report.rustdesk.completed && report.sidestore.completed else { throw AutomationFailure("missingTargetCompletion") }
+            report.outcome = .success
+        } catch {
+            let code = (error as? AutomationFailure)?.code ?? "refreshFailedSeeSideStoreLog"
+            if cancellation.isCancelled || error is CancellationError {
+                report.outcome = .cancelled
+            } else if code.hasPrefix("profileReadback") || ["deviceProfileVerificationUnavailable", "nativeInstallEvidenceMissing", "invalidCompletionCount", "emptyOrMismatchedResult"].contains(code) {
+                report.outcome = .unverified
+            } else { report.outcome = .failed }
+            report.errors.append(.init(code: code, app: !report.rustdesk.completed ? "rustdesk" : "sidestore"))
+        }
+        // No detached backend remains here. Killing the process is different:
+        // no report is returned, and its persisted lease stays interrupted.
+        report.terminal = true
+        report.cleanupAllowed = true
+        progress.completedUnitCount = progress.totalUnitCount
+        return report
+    }
+
+    /// Wait only for transport readiness, BEFORE any Apple session/profile
+    /// request. This does not retry authentication or a renewal operation.
+    private static func waitForNetworkReady(progress: Progress, cancellation: AutomationCancellation) async throws {
+        let started = ProcessInfo.processInfo.systemUptime
+        var attempt = 0
+        while AutomationRefreshPolicy.mayStartReadinessProbe(startedAt: started, now: ProcessInfo.processInfo.systemUptime) {
+            try cancellation.check()
+            attempt += 1
+            progress.localizedAdditionalDescription = "Waiting for LocalDevVPN (\(attempt))"
+            // These are sequential awaits, not a timer racing the probe. Even
+            // cancellation waits for an in-flight native check to finish before
+            // this method returns. The 30s window stops new probes; draining
+            // an already-started native call may take additional time.
+            await minimuxer.network.refreshEndpoint()
+            try cancellation.check()
+            let result = await minimuxer.core.isReady(withNetworkCheck: true)
+            try cancellation.check()
+            guard AutomationRefreshPolicy.mayStartReadinessProbe(startedAt: started, now: ProcessInfo.processInfo.systemUptime) else {
+                throw AutomationFailure("networkReadinessTimedOut")
+            }
+            switch result {
+            case .success(true):
+                return
+            case .success(false):
+                throw AutomationFailure("networkReadinessUnverified")
+            case .failure(let error):
+                let kind = readinessKind(error)
+                let remotePairing = minimuxer.gateway.pairingFileType == .rppairing
+                guard AutomationRefreshPolicy.mayRetryReadiness(kind, remotePairing: remotePairing) else {
+                    throw AutomationFailure(kind == .invalidPairing ? "pairingNotReady" : kind == .locked ? "deviceLocked" : "networkReadinessFailed")
+                }
+            }
+            let remaining = AutomationRefreshPolicy.networkReadyWindow - (ProcessInfo.processInfo.systemUptime - started)
+            guard remaining > 0 else { throw AutomationFailure("networkReadinessTimedOut") }
+            try await Task.sleep(nanoseconds: UInt64(min(0.5, remaining) * 1_000_000_000))
+        }
+        try cancellation.check()
+        throw AutomationFailure("networkReadinessTimedOut")
+    }
+
+    private static func readinessKind(_ error: MinimuxerError) -> AutomationRefreshPolicy.ReadinessFailure {
+        switch error {
+        case .invalidPairing, .pairingNotLoaded:
+            return .invalidPairing
+        case .noVPN(let reason):
+            return AutomationRefreshPolicy.readinessReasonIsPermanent(reason) ? .locked : .missingTunnel
+        case .noConnection(let reason):
+            return AutomationRefreshPolicy.readinessReasonIsPermanent(reason) ? .locked : .networkUnavailable
+        case .noDevice(let reason):
+            return AutomationRefreshPolicy.readinessReasonIsPermanent(reason) ? .locked : .endpointNotReady
+        case .notReachable(let reason):
+            return AutomationRefreshPolicy.readinessReasonIsPermanent(reason) ? .locked : .peerUnreachable
+        case .invalidVPN(let reason):
+            return AutomationRefreshPolicy.readinessReasonIsPermanent(reason) ? .locked : .invalidVPN
+        default:
+            // Includes notStarted, unconfigured transport and native service
+            // errors: do not guess that a pairing/locked-device error is transient.
+            return .unknown
+        }
+    }
+
+    private static func findTargets(context: NSManagedObjectContext) throws -> [AutomationTarget] {
+        let all = InstalledApp.all(in: context)
+        let rustdesk = all.filter { AutomationRefreshPolicy.matchesRustDesk(originalID: $0.bundleIdentifier) }
+        let own = all.filter { $0.bundleIdentifier == StoreApp.altstoreAppID }
+        guard rustdesk.count == 1, own.count == 1 else { throw AutomationFailure("missingOrAmbiguousTarget") }
+        return try [rustdesk[0], own[0]].enumerated().map { index, app in
+            guard app.isActive, let bundle = ALTApplication(fileURL: app.fileURL),
+                  let certificate = CertificateManager.shared.getSigningCertificate(at: bundle.fileURL) else {
+                throw AutomationFailure("targetOrSigningIdentityUnavailable")
+            }
+            let installed = app.resignedBundleIdentifier
+            if index == 0 {
+                guard let team = app.team?.identifier,
+                      installed == AutomationRefreshPolicy.rustDeskID || installed == AutomationRefreshPolicy.rustDeskID + "." + team,
+                      app.customBundleIdentifier == nil || app.customBundleIdentifier == AutomationRefreshPolicy.rustDeskID else {
+                    throw AutomationFailure("rustdeskIdentityMismatch")
+                }
+            } else {
+                guard installed == Bundle.main.bundleIdentifier else { throw AutomationFailure("sidestoreIdentityMismatch") }
+            }
+            guard bundle.bundleIdentifier == app.bundleIdentifier || bundle.bundleIdentifier == installed else {
+                throw AutomationFailure("cachedBundleIdentityMismatch")
+            }
+            var profileIDs: Set<String> = [installed]
+            if !app.useMainProfile {
+                // Personal signing may place TEAM after each entire extension ID,
+                // rather than reparenting it under the signed main ID. Use the
+                // installed database identities, never a guessed prefix.
+                guard app.appExtensions.count == bundle.appExtensions.count else {
+                    throw AutomationFailure("extensionIdentityUnavailable")
+                }
+                for ext in app.appExtensions {
+                    guard !ext.resignedBundleIdentifier.isEmpty,
+                          profileIDs.insert(ext.resignedBundleIdentifier).inserted else {
+                        throw AutomationFailure("extensionIdentityUnavailable")
+                    }
+                }
+            }
+            return AutomationTarget(app: app, originalID: app.bundleIdentifier, installedID: installed,
+                certificateSerial: certificate.serialNumber, profileIDs: profileIDs)
+        }
+    }
+}
diff --git a/SideStore/Core/Automation/AutomationRefreshIntent.swift b/SideStore/Core/Automation/AutomationRefreshIntent.swift
new file mode 100644
index 00000000..8f8d2baa
--- /dev/null
+++ b/SideStore/Core/Automation/AutomationRefreshIntent.swift
@@ -0,0 +1,97 @@
+import AppIntents
+import Foundation
+
+@available(iOS 27.0, *)
+struct PrepareAutomationIntent: AppIntent {
+    static var title: LocalizedStringResource = "Legacy Prepare Renewal (Update Shortcut)"
+    static var description = IntentDescription("Disabled legacy action. Use Prepare Automatic Renewal V2; this action never acquires a ticket.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        .result(value: AutomationRenewalWireV2.clientUpdateRequired)
+    }
+}
+
+@available(iOS 27.0, *)
+struct AutomationRefreshIntent: AppIntent {
+    static var title: LocalizedStringResource = "Legacy Execute Renewal (Update Shortcut)"
+    static var description = IntentDescription("Disabled legacy action. This action never starts or cancels a renewal.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+    @Parameter(title: "Run ID") var runID: String
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        .result(value: AutomationRenewalWireV2.clientUpdateRequired)
+    }
+}
+
+@available(iOS 27.0, *)
+struct FinalizeAutomationIntent: AppIntent {
+    static var title: LocalizedStringResource = "Legacy Finalize Renewal (Update Shortcut)"
+    static var description = IntentDescription("Disabled legacy action. This action never releases a renewal ticket.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+    @Parameter(title: "Run ID") var runID: String
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        .result(value: AutomationRenewalWireV2.clientUpdateRequired)
+    }
+}
+
+@available(iOS 27.0, *)
+struct PrepareRenewalV2Intent: AppIntent {
+    static var title: LocalizedStringResource = "Prepare Automatic Renewal V2"
+    static var description = IntentDescription("Reserve a task before changing VPNs; return string-only protocol sidestore-personal-renewal/2.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        .result(value: await AutomationRefreshCoordinator.shared.prepareV2().json)
+    }
+}
+
+@available(iOS 27.0, *)
+struct ExecuteRenewalV2Intent: LongRunningIntent, CancellableIntent {
+    static var title: LocalizedStringResource = "Renew RustDesk V2 and SideStore V2"
+    static var description = IntentDescription("Wait for native renewal and device verification. Return string-only terminal and cleanup states, including ordinary failures.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+    @Parameter(title: "Run ID") var runID: String
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        let cancellation = AutomationCancellation()
+        let report: AutomationRefreshReport
+        do {
+            report = try await performBackgroundTask {
+                await AutomationRefreshCoordinator.shared.execute(runID: runID, progress: progress, cancellation: cancellation)
+            } onCancel: { _ in
+                cancellation.cancel()
+            }
+        } catch {
+            // Even a runtime-extension failure must not return a legitimate
+            // ticket before its backend is cancelled and joined. OS process
+            // termination cannot run this code; the journal keeps that distinct.
+            report = await AutomationRefreshCoordinator.shared.cancelAndDrain(runID: runID, cancellation: cancellation)
+        }
+        return .result(value: AutomationExecuteV2Report(report: report).json)
+    }
+}
+
+@available(iOS 27.0, *)
+struct FinalizeRenewalV2Intent: AppIntent {
+    static var title: LocalizedStringResource = "Finish Renewal Network Recovery V2"
+    static var description = IntentDescription("Release the matching ticket only after VPN recovery; return a string-only finalization state.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+    @Parameter(title: "Run ID") var runID: String
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        .result(value: await AutomationRefreshCoordinator.shared.finalizeV2(runID: runID).json)
+    }
+}
+
+@available(iOS 27.0, *)
+struct AutomationStatusIntent: AppIntent {
+    static var title: LocalizedStringResource = "Get Last Renewal Status"
+    static var description = IntentDescription("Read the persisted last result. An interrupted process is not reported as a completed renewal.")
+    static var allowedExecutionTargets: IntentExecutionTargets { [.main] }
+
+    func perform() async throws -> some IntentResult & ReturnsValue<String> {
+        .result(value: await AutomationRefreshCoordinator.shared.status().json)
+    }
+}
diff --git a/SideStore/Core/Automation/AutomationRefreshPolicy.swift b/SideStore/Core/Automation/AutomationRefreshPolicy.swift
new file mode 100644
index 00000000..7a948b23
--- /dev/null
+++ b/SideStore/Core/Automation/AutomationRefreshPolicy.swift
@@ -0,0 +1,337 @@
+import Foundation
+
+/// The shortcut obtains a lease before changing VPNs and releases it only AFTER
+/// restoring the network. An abandoned lease is never silently stolen.
+struct AutomationLease: Codable, Sendable, Equatable {
+    enum Phase: String, Codable, Sendable {
+        case prepared, running, awaitingCleanup, finalized, interrupted
+    }
+    var runID: String
+    var phase: Phase
+    var report: AutomationRefreshReport
+
+    func canExecute(_ token: String) -> Bool {
+        runID == token && phase == .prepared
+    }
+
+    func canFinalize(_ token: String) -> Bool {
+        runID == token && phase == .awaitingCleanup && report.terminal
+    }
+
+    /// Multiple cancellation/execute waiters can join the same backend. Only
+    /// the first terminal commit may advance the lease; late waiters cannot
+    /// reopen a run whose network cleanup has already been finalized.
+    mutating func acceptTerminal(_ value: AutomationRefreshReport) -> Bool {
+        guard runID == value.runID, value.terminal,
+              phase == .prepared || phase == .running else { return false }
+        report = value
+        phase = .awaitingCleanup
+        return true
+    }
+
+    mutating func markProcessInterrupted() {
+        guard phase == .prepared || phase == .running else { return }
+        phase = .interrupted
+        report.terminal = false
+        report.cleanupAllowed = false
+        report.outcome = .unverified
+        report.errors.append(.init(code: "processInterrupted", app: nil))
+    }
+}
+
+struct AutomationRefreshError: Codable, Sendable, Equatable {
+    var code: String
+    var app: String?
+}
+
+struct AutomationAppReport: Codable, Sendable, Equatable {
+    var completed = false
+    var bundleID: String
+    var expiresAt: String?
+    var installedProfileUUIDs: [String] = []
+}
+
+struct AutomationRefreshReport: Codable, Sendable, Equatable {
+    enum Outcome: String, Codable, Sendable { case success, failed, cancelled, unverified }
+    var schemaVersion = 1
+    var runID: String
+    var terminal = false
+    var cleanupAllowed = false
+    var outcome: Outcome = .unverified
+    var rustdesk = AutomationAppReport(bundleID: AutomationRefreshPolicy.rustDeskID)
+    var sidestore = AutomationAppReport(bundleID: "")
+    var errors: [AutomationRefreshError] = []
+    var canCleanup: Bool { terminal && cleanupAllowed }
+
+    var json: String {
+        // Every field is a bounded Codable value; no Apple responses/credentials.
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        guard let data = try? encoder.encode(self), let text = String(data: data, encoding: .utf8) else {
+            return "{\"schemaVersion\":1,\"terminal\":false,\"cleanupAllowed\":false,\"outcome\":\"unverified\",\"errors\":[{\"code\":\"encodingFailed\"}]}"
+        }
+        return text
+    }
+}
+
+struct AutomationPrepareReport: Codable, Sendable {
+    var schemaVersion = 1
+    var ready: Bool
+    var runID: String
+    var outcome: String
+    var errors: [AutomationRefreshError] = []
+    var json: String {
+        String(data: (try? JSONEncoder().encode(self)) ?? Data(), encoding: .utf8) ?? "{}"
+    }
+}
+
+struct AutomationFinalizeReport: Codable, Sendable {
+    var schemaVersion = 1
+    var runID: String
+    var finalized: Bool
+    var released: Bool
+    var outcome: String
+    var json: String {
+        String(data: (try? JSONEncoder().encode(self)) ?? Data(), encoding: .utf8) ?? "{}"
+    }
+}
+
+/// Wire V2 deliberately has STRING VALUES ONLY. Shortcuts must compare these
+/// literals directly, never bridge JSON CFBoolean/NSNumber through Text.
+enum AutomationRenewalWireV2 {
+    static let protocolID = "sidestore-personal-renewal/2"
+
+    static func json<T: Encodable>(_ value: T) -> String {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        guard let data = try? encoder.encode(value), let result = String(data: data, encoding: .utf8) else {
+            return "{\"protocol\":\"sidestore-personal-renewal/2\",\"state\":\"storageError\",\"completionState\":\"nonterminal\",\"cleanupState\":\"blocked\",\"finalizationState\":\"blocked\",\"errorCode\":\"encodingFailed\"}"
+        }
+        return result
+    }
+
+    // Old action IDs stay discoverable so an installed old shortcut gets a
+    // fail-closed response, without acquiring, executing or releasing a lease.
+    static let clientUpdateRequired = "{\"protocol\":\"sidestore-personal-renewal/2\",\"state\":\"clientUpdateRequired\",\"completionState\":\"nonterminal\",\"cleanupState\":\"blocked\",\"finalizationState\":\"blocked\",\"errorCode\":\"clientUpdateRequired\",\"runID\":\"\"}"
+}
+
+struct AutomationPrepareV2Report: Codable, Sendable, Equatable {
+    var `protocol` = AutomationRenewalWireV2.protocolID
+    var state: String
+    var runID: String
+    var phase: String
+    var recoveryState: String
+    var errorCode: String
+
+    init(report: AutomationPrepareReport, phase: String, recoveryState: String = "none") {
+        state = report.ready ? "ready" : report.outcome == "busy" ? "busy" : report.outcome == "interrupted" ? "interrupted" : "storageError"
+        runID = report.runID
+        self.phase = phase
+        self.recoveryState = recoveryState
+        errorCode = report.errors.first?.code ?? "none"
+    }
+
+    var json: String { AutomationRenewalWireV2.json(self) }
+}
+
+struct AutomationExecuteV2Report: Codable, Sendable, Equatable {
+    var `protocol` = AutomationRenewalWireV2.protocolID
+    var runID: String
+    var completionState: String
+    var cleanupState: String
+    var outcome: String
+    var rustdeskState: String
+    var sidestoreState: String
+    var errorCode: String
+
+    init(report: AutomationRefreshReport) {
+        runID = report.runID
+        completionState = report.terminal ? "terminal" : "nonterminal"
+        cleanupState = report.canCleanup ? "allowed" : "blocked"
+        outcome = report.outcome.rawValue
+        rustdeskState = report.rustdesk.completed ? "completed" : "notCompleted"
+        sidestoreState = report.sidestore.completed ? "completed" : "notCompleted"
+        errorCode = report.errors.first?.code ?? "none"
+    }
+
+    var json: String { AutomationRenewalWireV2.json(self) }
+}
+
+struct AutomationFinalizeV2Report: Codable, Sendable, Equatable {
+    var `protocol` = AutomationRenewalWireV2.protocolID
+    var runID: String
+    var finalizationState: String
+    var errorCode: String
+
+    init(report: AutomationFinalizeReport) {
+        runID = report.runID
+        finalizationState = report.finalized && report.released ? "finalized" : "blocked"
+        errorCode = report.finalized && report.released ? "none" : report.outcome
+    }
+
+    var json: String { AutomationRenewalWireV2.json(self) }
+}
+
+/// Captured ONLY while loading the untouched journal in a new process. This
+/// evidence is not inferred from an in-memory .interrupted phase or worker=nil.
+struct AutomationColdPreparedEvidence: Sendable, Equatable {
+    let runID: String
+    let diskSHA256: String
+
+    init?(diskLease: AutomationLease, diskSHA256: String) {
+        guard AutomationRefreshPolicy.isPristinePrepared(diskLease), !diskSHA256.isEmpty else { return nil }
+        runID = diskLease.runID
+        self.diskSHA256 = diskSHA256
+    }
+
+    func permitsRecovery(current: AutomationLease, disk: AutomationLease, diskSHA256: String,
+                         hasWorker: Bool, hasCancellation: Bool) -> Bool {
+        guard !hasWorker, !hasCancellation, self.diskSHA256 == diskSHA256,
+              runID == disk.runID, AutomationRefreshPolicy.isPristinePrepared(disk) else { return false }
+        var expected = disk
+        expected.markProcessInterrupted()
+        return current == expected
+    }
+}
+
+/// The pinned Minimuxer backends have three DIFFERENT dumpProfiles contracts.
+/// Recognizing a contract selects where to read; it is never installation proof.
+enum AutomationProfileDumpLayout: Sendable, Equatable {
+    case uuidDirectory
+    case indexedFiles(count: Int)
+    case inlineProfiles([Data])
+}
+
+enum AutomationRefreshPolicy {
+    static let rustDeskID = "com.bearberni.rustdesk.v2"
+    static let maximumReadbackProfiles = 512
+    static let maximumReadbackProfileBytes = 2_000_000
+    static let maximumReadbackTotalBytes = 32_000_000
+
+    static func profileDumpLayout(returned: String, expectedDirectory: URL) -> AutomationProfileDumpLayout? {
+        guard returned.utf8.count <= maximumReadbackTotalBytes else { return nil }
+        // IdeviceGateway: absolute private directory; compare normalized paths,
+        // not URL directory hints/trailing slashes. Never follow an outside path.
+        if returned.hasPrefix("/"),
+           URL(fileURLWithPath: returned).standardizedFileURL.path == expectedDirectory.standardizedFileURL.path {
+            return .uuidDirectory
+        }
+        // LibimobiledeviceGateway RP: files are in docsPath itself, and the
+        // returned string is a status message rather than a filesystem path.
+        let prefix = "Successfully dumped "
+        let suffix = " profiles"
+        if returned.hasPrefix(prefix), returned.hasSuffix(suffix) {
+            let digits = returned.dropFirst(prefix.count).dropLast(suffix.count)
+            guard !digits.isEmpty, digits.utf8.allSatisfy({ (48...57).contains($0) }),
+                  let count = Int(digits), count <= maximumReadbackProfiles else { return nil }
+            return .indexedFiles(count: count)
+        }
+        // LibimobiledeviceGateway Lockdown: XML plist array of CMS profile Data;
+        // nothing is written to disk. Do not accept arbitrary text/XML objects.
+        guard returned.hasPrefix("<?xml"),
+              let profiles = try? PropertyListSerialization.propertyList(from: Data(returned.utf8), options: [], format: nil) as? [Data],
+              profiles.count <= maximumReadbackProfiles else { return nil }
+        var total = 0
+        for data in profiles {
+            guard !data.isEmpty, data.count < maximumReadbackProfileBytes else { return nil }
+            total += data.count
+            guard total <= maximumReadbackTotalBytes else { return nil }
+        }
+        return .inlineProfiles(profiles)
+    }
+
+    static func profileDumpFileMatches(_ name: String, layout: AutomationProfileDumpLayout) -> Bool {
+        guard !name.contains("/"), !name.contains("\\"), name.hasSuffix(".mobileprovision") else { return false }
+        switch layout {
+        case .uuidDirectory:
+            // The inner UUID's original spelling/case determines the upstream
+            // filename. Match the parsed profile UUID, never this filename.
+            return true
+        case .indexedFiles(let count):
+            guard name.hasPrefix("Profile_") else { return false }
+            let digits = name.dropFirst("Profile_".count).dropLast(".mobileprovision".count)
+            guard let index = Int(digits), index >= 0, index < count, String(index) == digits else { return false }
+            return true
+        case .inlineProfiles:
+            return false
+        }
+    }
+
+    static func isPristinePrepared(_ lease: AutomationLease) -> Bool {
+        let report = lease.report
+        return UUID(uuidString: lease.runID) != nil && lease.runID == report.runID &&
+            lease.phase == .prepared && report.schemaVersion == 1 &&
+            !report.terminal && !report.cleanupAllowed && report.outcome == .unverified && report.errors.isEmpty &&
+            !report.rustdesk.completed && !report.sidestore.completed &&
+            report.rustdesk.installedProfileUUIDs.isEmpty && report.sidestore.installedProfileUUIDs.isEmpty &&
+            report.rustdesk.expiresAt == nil && report.sidestore.expiresAt == nil
+    }
+
+    /// The caller may start a backend ONLY after this returns a running lease.
+    /// A throwing durable write yields no permit and must never start a worker.
+    static func commitRunningLease(_ lease: AutomationLease, runID: String,
+                                   persist: (AutomationLease) throws -> Void) throws -> AutomationLease? {
+        guard lease.canExecute(runID), lease.runID == lease.report.runID else { return nil }
+        var running = lease
+        running.phase = .running
+        try persist(running)
+        return running
+    }
+
+    enum ReadinessFailure: Sendable, Equatable {
+        case networkUnavailable, missingTunnel, endpointNotReady, peerUnreachable
+        case invalidVPN, invalidPairing, locked, unknown
+    }
+
+    static let networkReadyWindow: TimeInterval = 30
+
+    static func mayStartReadinessProbe(startedAt: TimeInterval, now: TimeInterval) -> Bool {
+        now >= startedAt && now - startedAt < networkReadyWindow
+    }
+
+    static func mayRetryReadiness(_ failure: ReadinessFailure, remotePairing: Bool) -> Bool {
+        switch failure {
+        case .networkUnavailable, .missingTunnel, .endpointNotReady, .peerUnreachable:
+            return true
+        case .invalidVPN:
+            // In the pinned core, RP uses invalidVPN for a failed peer TCP
+            // probe; lockdown also uses it for unsupported/missing IPsec.
+            return remotePairing
+        case .invalidPairing, .locked, .unknown:
+            return false
+        }
+    }
+
+    static func readinessReasonIsPermanent(_ reason: String) -> Bool {
+        let text = reason.lowercased()
+        // Conservative fail-fast override. These hints can NEVER authorize a
+        // retry; typed unknown errors below are also always non-retryable.
+        return ["pairing", "locked", "unlock", "passcode", "authentication", "denied"]
+            .contains { text.contains($0) }
+    }
+
+    /// Original ID must match exactly. A name/prefix match could select the
+    /// App Store client or another RustDesk build and is deliberately rejected.
+    static func matchesRustDesk(originalID: String) -> Bool { originalID == rustDeskID }
+
+    static func exactCompletion(requested: String, resultIDs: [String], succeededIDs: [String]) -> Bool {
+        resultIDs == [requested] && succeededIDs == [requested]
+    }
+
+    static func exactProfileIDs(expected: Set<String>, actual: [String]) -> Bool {
+        !expected.isEmpty && Set(actual).count == actual.count && Set(actual) == expected
+    }
+
+    static func verifiedProfile(expectedUUID: String, expectedHash: String,
+                                actualUUID: String, actualHash: String,
+                                expectedBundleID: String, actualBundleID: String,
+                                expectedTeamID: String, actualTeamID: String,
+                                expiry: Date, now: Date) -> Bool {
+        expectedUUID == actualUUID && expectedHash == actualHash &&
+        expectedBundleID == actualBundleID && expectedTeamID == actualTeamID && expiry > now
+    }
+
+    static func timestamp(_ date: Date) -> String {
+        ISO8601DateFormatter().string(from: date)
+    }
+}
