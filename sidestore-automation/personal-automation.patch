+    func testOnlyProvenColdPreparedJournalCanRecover() throws {
+        let disk = preparedLease()
+        let evidence = try XCTUnwrap(AutomationColdPreparedEvidence(diskLease: disk, diskSHA256: "originalHash"))
+        var loaded = disk
+        loaded.markProcessInterrupted()
+        XCTAssertTrue(evidence.permitsRecovery(current: loaded, disk: disk, diskSHA256: "originalHash", hasWorker: false, hasCancellation: false))
+        // A newly acquired ticket in this same process must never be stolen.
+        XCTAssertFalse(evidence.permitsRecovery(current: disk, disk: disk, diskSHA256: "originalHash", hasWorker: false, hasCancellation: false))
+        XCTAssertFalse(evidence.permitsRecovery(current: loaded, disk: disk, diskSHA256: "changedHash", hasWorker: false, hasCancellation: false))
+        XCTAssertFalse(evidence.permitsRecovery(current: loaded, disk: disk, diskSHA256: "originalHash", hasWorker: true, hasCancellation: false))
+        XCTAssertFalse(evidence.permitsRecovery(current: loaded, disk: disk, diskSHA256: "originalHash", hasWorker: false, hasCancellation: true))
+        loaded.runID = UUID().uuidString
