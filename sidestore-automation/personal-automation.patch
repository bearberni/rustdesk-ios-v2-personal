diff --git a/AutomationTests/AutomationRefreshPolicyTests.swift b/AutomationTests/AutomationRefreshPolicyTests.swift
new file mode 100644
index 00000000..87f8234e
--- /dev/null
+++ b/AutomationTests/AutomationRefreshPolicyTests.swift
@@ -0,0 +1,108 @@
+import XCTest
+@testable import SideStoreAutomationPolicy
+
+final class AutomationRefreshPolicyTests: XCTestCase {
+    func testExactOriginalRustDeskIDRejectsOtherClientsAndPrefixes() {
+        XCTAssertTrue(AutomationRefreshPolicy.matchesRustDesk(originalID: "com.bearberni.rustdesk.v2"))
+        for wrong in ["com.carriez.RustDesk", "com.bearberni.rustdesk.v2.other", "com.bearberni.rustdesk", "RustDesk V2"] {
+            XCTAssertFalse(AutomationRefreshPolicy.matchesRustDesk(originalID: wrong))
+        }
+    }
+
+    func testEmptyOrMismatchedCompletionIsNeverSuccess() {
+        XCTAssertFalse(AutomationRefreshPolicy.exactCompletion(requested: "target", resultIDs: [], succeededIDs: []))
+        XCTAssertFalse(AutomationRefreshPolicy.exactCompletion(requested: "target", resultIDs: ["other"], succeededIDs: ["other"]))
+        XCTAssertFalse(AutomationRefreshPolicy.exactCompletion(requested: "target", resultIDs: ["target"], succeededIDs: []))
+        XCTAssertTrue(AutomationRefreshPolicy.exactCompletion(requested: "target", resultIDs: ["target"], succeededIDs: ["target"]))
+    }
+
+    func testLeaseIsHeldThroughNetworkCleanup() {
+        var lease = AutomationLease(runID: "owner", phase: .prepared, report: .init(runID: "owner"))
+        XCTAssertTrue(lease.canExecute("owner"))
+        XCTAssertFalse(lease.canExecute("stale"))
+        lease.phase = .running
+        XCTAssertFalse(lease.canFinalize("owner"))
+        lease.phase = .awaitingCleanup
+        XCTAssertFalse(lease.canFinalize("owner")) // A non-terminal report cannot release.
+        lease.report.terminal = true
+        XCTAssertTrue(lease.canFinalize("owner"))
+        XCTAssertFalse(lease.canFinalize("stale"))
+    }
+
+    func testProcessRestartNeverManufacturesFinallyOrSuccess() {
+        for phase in [AutomationLease.Phase.prepared, .running] {
+            var lease = AutomationLease(runID: "owner", phase: phase, report: .init(runID: "owner"))
+            lease.markProcessInterrupted()
+            XCTAssertEqual(lease.phase, .interrupted)
+            XCTAssertFalse(lease.report.terminal)
+            XCTAssertFalse(lease.report.cleanupAllowed)
+            XCTAssertFalse(lease.report.canCleanup)
+            XCTAssertFalse(lease.canExecute("owner"))
+            XCTAssertFalse(lease.canFinalize("owner"))
+        }
+    }
+
+    func testCompletedRunSurvivesRestartAsCleanupPending() {
+        var report = AutomationRefreshReport(runID: "owner")
+        report.terminal = true
+        report.cleanupAllowed = true
+        var lease = AutomationLease(runID: "owner", phase: .awaitingCleanup, report: report)
+        lease.markProcessInterrupted()
+        XCTAssertEqual(lease.phase, .awaitingCleanup)
+        XCTAssertTrue(lease.canFinalize("owner"))
+    }
+
+    func testLateTerminalWaiterCannotReopenFinalizedLease() {
+        var lease = AutomationLease(runID: "owner", phase: .running, report: .init(runID: "owner"))
+        var terminal = AutomationRefreshReport(runID: "owner")
+        terminal.terminal = true
+        terminal.cleanupAllowed = true
+        terminal.outcome = .success
+        XCTAssertTrue(lease.acceptTerminal(terminal))
+        var lateFailure = terminal
+        lateFailure.outcome = .failed
+        XCTAssertFalse(lease.acceptTerminal(lateFailure))
+        XCTAssertEqual(lease.report.outcome, .success)
+        lease.phase = .finalized
+        XCTAssertFalse(lease.acceptTerminal(lateFailure))
+        XCTAssertEqual(lease.phase, .finalized)
+        lateFailure.runID = "another-run"
+        XCTAssertFalse(lease.acceptTerminal(lateFailure))
+    }
+
+    func testProfileReadbackRequiresUUIDHashIdentityAndFutureValidity() {
+        let now = Date(timeIntervalSince1970: 1_000)
+        func valid(uuid: String = "uuid", hash: String = "hash", bundle: String = "app", team: String = "team", expiry: Date = Date(timeIntervalSince1970: 2_000)) -> Bool {
+            AutomationRefreshPolicy.verifiedProfile(expectedUUID: "uuid", expectedHash: "hash",
+                actualUUID: uuid, actualHash: hash, expectedBundleID: "app", actualBundleID: bundle,
+                expectedTeamID: "team", actualTeamID: team, expiry: expiry, now: now)
+        }
+        XCTAssertTrue(valid())
+        XCTAssertFalse(valid(uuid: "old-profile"))
+        XCTAssertFalse(valid(hash: "different-bytes"))
+        XCTAssertFalse(valid(bundle: "other-app"))
+        XCTAssertFalse(valid(team: "other-team"))
+        XCTAssertFalse(valid(expiry: now))
+    }
+
+    func testPersonalExtensionIDsUseExactInstalledIdentitiesNotMainPrefix() {
+        let main = "com.SideStore.SideStore.TEAM"
+        let widget = "com.SideStore.SideStore.Widget.TEAM"
+        let expected: Set<String> = [main, widget]
+        XCTAssertTrue(AutomationRefreshPolicy.exactProfileIDs(expected: expected, actual: [widget, main]))
+        XCTAssertFalse(AutomationRefreshPolicy.exactProfileIDs(expected: expected, actual: [main, main + ".Widget"]))
+        XCTAssertFalse(AutomationRefreshPolicy.exactProfileIDs(expected: expected, actual: [main, main]))
+    }
+
+    func testJSONContractDoesNotImplySuccessFromTerminalAlone() throws {
+        var report = AutomationRefreshReport(runID: "owner")
+        report.terminal = true
+        report.cleanupAllowed = true
+        report.outcome = .failed
+        let decoded = try JSONDecoder().decode(AutomationRefreshReport.self, from: Data(report.json.utf8))
+        XCTAssertEqual(decoded.schemaVersion, 1)
+        XCTAssertEqual(decoded.runID, "owner")
+        XCTAssertFalse(decoded.rustdesk.completed)
+        XCTAssertEqual(decoded.outcome, .failed)
+    }
+}
