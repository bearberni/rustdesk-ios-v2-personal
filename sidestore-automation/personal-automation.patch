+    func testWorkerStartRequiresSuccessfulRunningJournalWrite() throws {
+        enum WriteFailure: Error { case denied }
+        let prepared = preparedLease()
+        var workerStarts = 0
+        var writeCalls = 0
+        do {
+            if try AutomationRefreshPolicy.commitRunningLease(prepared, runID: prepared.runID, persist: { lease in
+                writeCalls += 1
+                XCTAssertEqual(lease.phase, .running)
+                throw WriteFailure.denied
+            }) != nil { workerStarts += 1 }
+            XCTFail("A failed journal write must throw before the worker permit is returned")
+        } catch WriteFailure.denied { } catch { XCTFail("Unexpected error: \(error)") }
+        XCTAssertEqual(writeCalls, 1)
+        XCTAssertEqual(workerStarts, 0)
+        XCTAssertEqual(prepared.phase, .prepared)
+        var persisted: AutomationLease?
+        let permit = try AutomationRefreshPolicy.commitRunningLease(prepared, runID: prepared.runID) { persisted = $0 }
+        if permit != nil { workerStarts += 1 }
+        XCTAssertEqual(persisted?.phase, .running)
+        XCTAssertEqual(permit, persisted)
+        XCTAssertEqual(workerStarts, 1)
+        XCTAssertNil(try AutomationRefreshPolicy.commitRunningLease(prepared, runID: "stale") { _ in XCTFail("Stale token must not write") })
+    }
