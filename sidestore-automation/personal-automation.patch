+import Foundation
+#if SWIFT_PACKAGE
+import AutomationSQLite
+#else
+import SQLite3
+#endif
+import CryptoKit
+
+// This helper never reads Keychain/pairing and never removes a legacy source.
+// Receipts and snapshots remain beside the app's private database, never in CI.
+enum AutomationUpgradeStorageError: Error, Equatable {
+    case invalidLocation
+    case unsupportedEntry
+    case destinationConflict
+    case sourceChanged
+    case invalidReceipt
+    case invalidSQLite
+    case sqlite(stage: String, code: Int32)
+    case filesystem(stage: String, code: Int)
+    case maintenanceBusy
+    case invalidCounter
+    case fingerprintUnavailable
+    case certificateInvalid
+    case certificateSerialConflict
+}
+
+enum AutomationUpgradeStorage {
+    private struct SourceStamp: Codable, Equatable {
+        var main: String
+        var wal: String?
+    }
+    private struct Receipt: Codable {
+        var version: Int
+        var phase: String
+        var sourceName: String
+        var destinationName: String
+        var sourceStamp: SourceStamp
+        var snapshotName: String
+        var snapshotSHA256: String
+    }
+    private struct Entry: Equatable {
+        var path: String
+        var directory: Bool
+        var sha256: String?
+    }
+
+    static func fileSHA256(_ url: URL) throws -> String {
+        let values = try url.resourceValues(forKeys: [.isRegularFileKey, .isSymbolicLinkKey])
+        guard values.isRegularFile == true && values.isSymbolicLink != true else {
+            throw AutomationUpgradeStorageError.unsupportedEntry
+        }
+        let input = try FileHandle(forReadingFrom: url)
+        defer { try? input.close() }
+        var hash = SHA256()
+        while let data = try input.read(upToCount: 64 * 1024), !data.isEmpty { hash.update(data: data) }
+        return hash.finalize().map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func manifest(_ root: URL) throws -> [Entry] {
+        let values = try root.resourceValues(forKeys: [.isDirectoryKey, .isRegularFileKey, .isSymbolicLinkKey])
+        guard values.isSymbolicLink != true else { throw AutomationUpgradeStorageError.unsupportedEntry }
+        if values.isRegularFile == true {
+            return [Entry(path: ".", directory: false, sha256: try fileSHA256(root))]
+        }
+        guard values.isDirectory == true else { throw AutomationUpgradeStorageError.unsupportedEntry }
+        var result = [Entry(path: ".", directory: true, sha256: nil)]
+        func visit(_ directory: URL, relative: String) throws {
+            for item in try FileManager.default.contentsOfDirectory(
+                at: directory, includingPropertiesForKeys: [.isDirectoryKey, .isRegularFileKey, .isSymbolicLinkKey]
+            ).sorted(by: { $0.lastPathComponent < $1.lastPathComponent }) {
+                let name = relative.isEmpty ? item.lastPathComponent : relative + "/" + item.lastPathComponent
+                let info = try item.resourceValues(forKeys: [.isDirectoryKey, .isRegularFileKey, .isSymbolicLinkKey])
+                guard info.isSymbolicLink != true else { throw AutomationUpgradeStorageError.unsupportedEntry }
+                if info.isDirectory == true {
+                    result.append(Entry(path: name, directory: true, sha256: nil))
+                    try visit(item, relative: name)
+                } else if info.isRegularFile == true {
+                    result.append(Entry(path: name, directory: false, sha256: try fileSHA256(item)))
+                } else {
+                    throw AutomationUpgradeStorageError.unsupportedEntry
+                }
+            }
+        }
+        try visit(root, relative: "")
+        return result.sorted { $0.path < $1.path }
+    }
+
+    static func verifiedCopy(source: URL, destination: URL) throws {
+        guard source.standardizedFileURL != destination.standardizedFileURL else {
+            throw AutomationUpgradeStorageError.invalidLocation
+        }
+        let expected = try manifest(source)
+        let fm = FileManager.default
+        if fm.fileExists(atPath: destination.path) {
+            guard try manifest(destination) == expected else { throw AutomationUpgradeStorageError.destinationConflict }
+            return
+        }
+        let parent = destination.deletingLastPathComponent()
+        try fm.createDirectory(at: parent, withIntermediateDirectories: true)
+        let staging = parent.appendingPathComponent(".upgrade-copy-" + UUID().uuidString)
+        var ownStaging = false
+        defer { if ownStaging { try? fm.removeItem(at: staging) } }
+        ownStaging = true
+        try fm.copyItem(at: source, to: staging)
+        guard try manifest(staging) == expected && manifest(source) == expected else {
+            throw AutomationUpgradeStorageError.sourceChanged
+        }
+        // Same-directory publication; an existing destination is never replaced.
+        try fm.moveItem(at: staging, to: destination)
+        ownStaging = false
+        guard try manifest(destination) == expected else { throw AutomationUpgradeStorageError.destinationConflict }
+    }
+
+    private static func stamp(_ source: URL) throws -> SourceStamp {
+        let wal = URL(fileURLWithPath: source.path + "-wal")
+        return SourceStamp(main: try fileSHA256(source),
+            wal: FileManager.default.fileExists(atPath: wal.path) ? try fileSHA256(wal) : nil)
+    }
+
+    private static func open(_ url: URL, flags: Int32) throws -> OpaquePointer {
+        var connection: OpaquePointer?
+        let result = sqlite3_open_v2(url.path, &connection, flags | SQLITE_OPEN_FULLMUTEX, nil)
+        guard result == SQLITE_OK, let connection else {
+            if let connection { sqlite3_close(connection) }
+            throw AutomationUpgradeStorageError.sqlite(stage: "open", code: result)
+        }
+        sqlite3_busy_timeout(connection, 2_000)
+        return connection
+    }
+
+    private static func execute(_ db: OpaquePointer, _ sql: String, stage: String) throws {
+        let result = sqlite3_exec(db, sql, nil, nil, nil)
+        guard result == SQLITE_OK else { throw AutomationUpgradeStorageError.sqlite(stage: stage, code: result) }
+    }
+
+    private static func singleText(_ db: OpaquePointer, _ sql: String) throws -> String {
+        var statement: OpaquePointer?
+        let result = sqlite3_prepare_v2(db, sql, -1, &statement, nil)
+        guard result == SQLITE_OK, let statement else {
+            throw AutomationUpgradeStorageError.sqlite(stage: "prepareCheck", code: result)
+        }
+        defer { sqlite3_finalize(statement) }
+        let step = sqlite3_step(statement)
+        guard step == SQLITE_ROW, let text = sqlite3_column_text(statement, 0) else {
+            throw AutomationUpgradeStorageError.sqlite(stage: "readCheck", code: step)
+        }
+        return String(cString: text)
+    }
+
+    static func validateSQLite(_ url: URL) throws {
+        let connection = try open(url, flags: SQLITE_OPEN_READONLY)
+        defer { sqlite3_close(connection) }
+        guard try singleText(connection, "PRAGMA quick_check") == "ok" else {
+            throw AutomationUpgradeStorageError.invalidSQLite
+        }
+    }
+
+    private static func backup(_ source: OpaquePointer, to destination: URL) throws {
+        let target = try open(destination, flags: SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE)
+        defer { sqlite3_close(target) }
+        guard let backup = sqlite3_backup_init(target, "main", source, "main") else {
+            throw AutomationUpgradeStorageError.sqlite(stage: "backupInit", code: sqlite3_errcode(target))
+        }
+        var finished = false
+        defer { if !finished { sqlite3_backup_finish(backup) } }
+        let deadline = ProcessInfo.processInfo.systemUptime + 5
+        while true {
+            let result = sqlite3_backup_step(backup, 128)
+            if result == SQLITE_DONE { break }
+            guard result == SQLITE_OK || result == SQLITE_BUSY || result == SQLITE_LOCKED else {
+                throw AutomationUpgradeStorageError.sqlite(stage: "backupStep", code: result)
+            }
+            guard ProcessInfo.processInfo.systemUptime < deadline else {
+                throw AutomationUpgradeStorageError.sqlite(stage: "backupDeadline", code: result)
+            }
+            if result != SQLITE_OK { sqlite3_sleep(20) }
+        }
+        let result = sqlite3_backup_finish(backup)
+        finished = true
+        guard result == SQLITE_OK else { throw AutomationUpgradeStorageError.sqlite(stage: "backupFinish", code: result) }
+        guard try singleText(target, "PRAGMA journal_mode=DELETE") == "delete",
+              try singleText(target, "PRAGMA quick_check") == "ok" else {
+            throw AutomationUpgradeStorageError.invalidSQLite
+        }
+    }
+
+    private static func writeReceipt(_ receipt: Receipt, to url: URL) throws {
+        let data = try JSONEncoder().encode(receipt)
+        try data.write(to: url, options: .atomic)
+        guard try Data(contentsOf: url) == data else { throw AutomationUpgradeStorageError.invalidReceipt }
+    }
+
+    static func preserveSQLite(source: URL, destination: URL) throws {
+        let fm = FileManager.default
+        let parent = destination.deletingLastPathComponent().standardizedFileURL
+        guard source.standardizedFileURL != destination.standardizedFileURL,
+              source.deletingLastPathComponent().standardizedFileURL == parent else {
+            throw AutomationUpgradeStorageError.invalidLocation
+        }
+        let receiptURL = parent.appendingPathComponent("." + destination.lastPathComponent + ".upgrade-receipt.json")
+        let snapshots = parent.appendingPathComponent(".upgrade-preservation", isDirectory: true)
+        if fm.fileExists(atPath: destination.path) {
+            guard let data = try? Data(contentsOf: receiptURL),
+                  var receipt = try? JSONDecoder().decode(Receipt.self, from: data),
+                  receipt.version == 1, ["prepared", "committed"].contains(receipt.phase),
+                  receipt.sourceName == source.lastPathComponent,
+                  receipt.destinationName == destination.lastPathComponent,
+                  UUID(uuidString: (receipt.snapshotName as NSString).deletingPathExtension) != nil,
+                  (receipt.snapshotName as NSString).pathExtension == "sqlite",
+                  (receipt.snapshotName as NSString).lastPathComponent == receipt.snapshotName else {
+                throw AutomationUpgradeStorageError.invalidReceipt
+            }
+            let snapshot = snapshots.appendingPathComponent(receipt.snapshotName)
+            guard try stamp(source) == receipt.sourceStamp,
+                  try fileSHA256(snapshot) == receipt.snapshotSHA256 else {
+                throw AutomationUpgradeStorageError.sourceChanged
+            }
+            try validateSQLite(destination)
+            if receipt.phase == "prepared" {
+                guard try fileSHA256(destination) == receipt.snapshotSHA256 else {
+                    throw AutomationUpgradeStorageError.destinationConflict
+                }
+                receipt.phase = "committed"
+                try writeReceipt(receipt, to: receiptURL)
+            }
+            return
+        }
+        // No new database is published until the read snapshot is complete.
+        let reader = try open(source, flags: SQLITE_OPEN_READONLY)
+        defer { sqlite3_close(reader) }
+        try execute(reader, "BEGIN", stage: "beginRead")
+        defer { sqlite3_exec(reader, "ROLLBACK", nil, nil, nil) }
+        _ = try singleText(reader, "SELECT count(*) FROM sqlite_schema")
+        let before = try stamp(source)
+        try fm.createDirectory(at: snapshots, withIntermediateDirectories: true)
+        let snapshot = snapshots.appendingPathComponent(UUID().uuidString + ".sqlite")
+        try backup(reader, to: snapshot)
+        guard try stamp(source) == before else { throw AutomationUpgradeStorageError.sourceChanged }
+        let snapshotHash = try fileSHA256(snapshot)
+        var receipt = Receipt(version: 1, phase: "prepared", sourceName: source.lastPathComponent,
+            destinationName: destination.lastPathComponent, sourceStamp: before,
+            snapshotName: snapshot.lastPathComponent, snapshotSHA256: snapshotHash)
+        try writeReceipt(receipt, to: receiptURL)
+        try verifiedCopy(source: snapshot, destination: destination)
+        try validateSQLite(destination)
+        receipt.phase = "committed"
+        try writeReceipt(receipt, to: receiptURL)
+    }
+
+    static func readCounter(at url: URL, maximum: Int) throws -> Int {
+        guard FileManager.default.fileExists(atPath: url.path) else { return 0 }
+        guard let value = Int(try String(contentsOf: url, encoding: .utf8).trimmingCharacters(in: .whitespacesAndNewlines)),
+              value >= 0 && value <= maximum else { throw AutomationUpgradeStorageError.invalidCounter }
+        return value
+    }
+
+    static func writeCounter(_ value: Int, at url: URL) throws {
+        try Data(String(value).utf8).write(to: url, options: .atomic)
+        guard try readCounter(at: url, maximum: value) == value else {
+            throw AutomationUpgradeStorageError.invalidCounter
+        }
+    }
+}
